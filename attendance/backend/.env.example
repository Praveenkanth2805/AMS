APP_ENV=dev
SECRET_KEY=change-this-to-a-long-random-32-byte-string-minimum
DATABASE_URL=postgresql+psycopg://attendance:attendance@localhost:5432/attendance
REDIS_URL=redis://localhost:6379/0

# Academic year settings
ACADEMIC_YEAR_START_MONTH=6
INSTITUTIONAL_TIMEZONE=Asia/Kolkata

# CORS / cookies
CORS_ORIGINS=["http://localhost:3000"]
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Rate limits
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_WRITE=60/minute

# Auto-bootstrap (dev friendly — disable in production if using a real migration pipeline)
AUTO_CREATE_TABLES=true
AUTO_SEED_DEFAULTS=true

# Bootstrap admin (only created if not already present)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_NAME=Administrator