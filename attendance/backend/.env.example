APP_ENV=dev
SECRET_KEY=change-this-to-a-long-random-32-byte-string-minimum
DATABASE_URL=postgresql+psycopg://attendance:attendance@localhost:5432/attendance
REDIS_URL=redis://localhost:6379/0

ACADEMIC_YEAR_START_MONTH=6
INSTITUTIONAL_TIMEZONE=Asia/Kolkata

CORS_ORIGINS=["http://localhost:3000"]
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_WRITE=60/minute

AUTO_CREATE_TABLES=true
AUTO_SEED_DEFAULTS=true
# DANGER: drops every table on startup. Dev only. Refused when APP_ENV=prod.
RESET_DB=false
# Allow editing attendance after submission. DEV/MIGRATION ONLY.
# When false (recommended), sessions are immutable (one-time submit).
ALLOW_ATTENDANCE_EDIT=false
# --------------------------------------------------------------
# Admin users are NOT auto-created from env.
# Create one manually after first startup:
#
#   python -m scripts.create_admin \
#     --email admin@example.com \
#     --name "Administrator" \
#     --role admin
#
# See backend/README.md → "Creating an admin user"
# --------------------------------------------------------------